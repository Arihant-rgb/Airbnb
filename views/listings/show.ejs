<% layout("/layouts/boilerplate")%>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Listing Details : </h3>
            <div class="card">
                <img src="<%=listing.image%>" class="card-img-top show-img" alt="listing-img">
                <div class="card-body">
                    <p class="card-text">
                        <%= listing.title %>
                    </p>
                </div>
            </div>
            <ul>
                <li>
                    <%= listing.title %>
                </li>
                <li>
                    <%= listing.description %>
                </li>
                <li>&#x20B9 <%= listing.price.toLocaleString("en-IN") %>
                </li>
                <li>
                    <%= listing.location %>
                </li>
                <li>
                    <%= listing.country %>
                </li>
            </ul>
            <br />
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit this listing</a>
            <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
                <button type="submit" class="btn btn-dark mt-3">Delete</button>
            </form>
        </div>
    </div>
</body>
